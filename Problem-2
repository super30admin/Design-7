// Time Complexity: O(n)
// Space Complexity: O(1)

// Keep track of the snake's body using a linked list
// For every move update the head of the snake and check if the head hits a wall or itself
// If head moves to a food cell then add the new position as the head  without removing the tail

class SnakeGame {
    int height;
    int width;
    LinkedList<int[]> snake;
    int index;
    int[][] food;

    public SnakeGame(int width, int height, int[][] food) {
        this.width = width;
        this.height = height;
        this.index = 0;
        this.food = food;
        this.snake = new LinkedList<>();
        snake.addFirst(new int[] {0,0});
    }
    
    public int move(String direction) {
        int[] snakeHead = snake.getFirst();
        int r = snakeHead[0]; 
        int c = snakeHead[1]; 
        
        if(direction.equals("R")) 
            c++;
        else if(direction.equals("L"))  
            c--;        
        else if(direction.equals("U"))  
            r--;        
        else 
            r++;
        
        // check out of bounds
        if(r < 0 || r >= height || c < 0 || c >= width)
            return -1;    
        // check if snake hits itself
        for(int i = 0; i < snake.size()-1; i++) {
            int[] pos = snake.get(i);
            if(pos[0] == r && pos[1] == c)
                return -1;
        }
        // check food cell
        if(index < food.length) {
            int[] foodCell = food[index];
            if(r == foodCell[0] && c == foodCell[1]) {
                snake.addFirst(new int[]{r, c});
                index++;
                return snake.size() - 1;
            }
        }
        // Normal movement
        snake.addFirst(new int[]{r, c});
        snake.removeLast();
        return snake.size() - 1;
    }
}

